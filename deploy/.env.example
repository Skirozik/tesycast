# Copy to .env and fill in. Used by deploy/docker-compose.yml.

PUBLIC_DOMAIN=example.com
ACME_EMAIL=you@example.com
BRAND=Tesycast

# Source link shown in the top-right of the landing page
REPO_URL=https://github.com/Skirozik/tesycast

# LiveKit credentials — used by BOTH LiveKit and the relay (keep them in sync).
# API key can stay "devkey"; the SECRET must be long & random (min 32 chars).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_to_a_long_random_string_min_32_chars
